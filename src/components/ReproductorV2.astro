---
import IconMusicNote from '@/assets/icon-music-note.astro';
import IconPause from '@/assets/icon-pause.astro';
import IconPlay from '@/assets/icon-play.astro';
import IconMute from '@/assets/icon-mute.astro';
import IconVolume from '@/assets/icon-volume.astro';

interface Props {
    src: string;
    title: string;
}

const {src, title} = Astro.props;
---

<aside class="absolute bottom-5 z-50 px-4 h-full w-full max-w-xl mx-auto">
  <section data-media-player class="sticky top-5 z-50 backdrop-blur-md rounded-full px-4 py-2.5 shadow-lg flex items-center justify-between gap-3 transition-all duration-300">
    <audio data-audio src={ src } preload="metadata"></audio>
    <!-- Music Info & Art -->
    <section class="flex items-center gap-3 min-w-0">
        <article class="relative w-10 h-10 rounded-full overflow-hidden bg-dusty-rose-200 shrink-0 shadow-inner flex items-center justify-center">
            <IconMusicNote class:list={"text-dusty-rose-800 text-lg animate-spin w-5"} style="animation-duration: 120s;"/>
        </article>
        <article class="flex flex-col min-w-0">
            <span class="text-caption text-dusty-rose-700 uppercase tracking-widest truncate">Música de Fondo</span>
            <span class="text-label-md text-dusty-rose-900 font-semibold truncate">{ title }</span>
        </article>
    </section>
    <!-- Controls & Sliders -->
    <section class="flex items-center gap-2 shrink-0">
    <!-- Play / Pause CTA -->
        <button data-play aria-label="Reproducir música" class="w-10 h-10 rounded-full bg-dusty-rose-700 text-on-primary flex items-center justify-center shadow-md active:scale-95 transition-transform" type="button">
            <IconPlay class:list={"text-dusty-rose-200 size-6"}/>
            <IconPause class:list={"text-dusty-rose-200 hidden size-6"}/>
        </button>
        <!-- Volume Toggle Drop/Slider -->
        <article class="relative flex items-center">
            <button data-mute aria-label="Silenciar o volumen" class="w-8 h-8 rounded-full bg-dusty-rose-100 text-dusty-rose-900 flex items-center justify-center active:scale-95" type="button">
                <IconVolume class:list={"text-dusty-rose-400 size-5"}/>
                <IconMute class:list={"text-dusty-rose-400 size-5 hidden"}/>
            </button>
            <input data-volume type="range" min="0" max="1" value="0.8" step="0.01" class="h-2 w-28 cursor-pointer accent-dusty-rose-600 hidden sm:block" aria-label="Volumen" />
        </article>
    </section>
  </section>
</aside>

<script>
  function initializePlayers() {
    const players = document.querySelectorAll<HTMLElement>("[data-media-player]");

    players.forEach((player) => {
      // Prevent the same player from being initialized twice
      if (player.dataset.initialized === "true") {
        return;
      }

      player.dataset.initialized = "true";

      const audio = player.querySelector<HTMLAudioElement>("[data-audio]");
      const playButton = player.querySelector<HTMLButtonElement>("[data-play]");
      const playIcon = player.querySelector<SVGElement>("[data-play-icon]");
      const pauseIcon = player.querySelector<SVGElement>("[data-pause-icon]");
      const volume = player.querySelector<HTMLInputElement>("[data-volume]");
      const muteButton = player.querySelector<HTMLButtonElement>("[data-mute]");
      const volumeIcon = player.querySelector<SVGElement>("[data-volume-icon]");
      const mutedIcon = player.querySelector<SVGElement>("[data-muted-icon]");
    
      if (
        !audio ||
        !playButton ||
        !playIcon ||
        !pauseIcon ||
        !volume ||
        !muteButton ||
        !volumeIcon ||
        !mutedIcon
      ) {
        return;
      }

      /* -----------------------------
       * Initial volume
       * ----------------------------- */

      audio.volume = Number(volume.value);

      /* -----------------------------
       * Play / Pause
       * ----------------------------- */

      playButton.addEventListener("click", async () => {
        if (audio.paused) {
          try {
            await audio.play();
          } catch (error) {
            console.error("Unable to play audio:", error);
          }
        } else {
          audio.pause();
        }
      });

      audio.addEventListener("play", () => {
        playIcon.classList.add("hidden");
        pauseIcon.classList.remove("hidden");

        playButton.setAttribute("aria-label", "Pause audio");
      });

      audio.addEventListener("pause", () => {
        playIcon.classList.remove("hidden");
        pauseIcon.classList.add("hidden");

        playButton.setAttribute("aria-label", "Play audio");
      });

      /* -----------------------------
       * Duration
       * ----------------------------- */

      const updateDuration = () => {
        if (!Number.isFinite(audio.duration)) {
          return;
        }
      };

      audio.addEventListener("loadedmetadata", updateDuration);
      audio.addEventListener("durationchange", updateDuration);

      /* -----------------------------
       * Audio finished
       * ----------------------------- */

      audio.addEventListener("ended", () => {
        playIcon.classList.remove("hidden");
        pauseIcon.classList.add("hidden");

        playButton.setAttribute("aria-label", "Play audio");
      });

      /* -----------------------------
       * Volume
       * ----------------------------- */

      volume.addEventListener("input", () => {
        const value = Number(volume.value);

        audio.volume = value;
        audio.muted = value === 0;
      });

      /* -----------------------------
       * Mute
       * ----------------------------- */

      muteButton.addEventListener("click", () => {
        audio.muted = !audio.muted;
      });

      audio.addEventListener("volumechange", () => {
        const isMuted = audio.muted || audio.volume === 0;

        volumeIcon.classList.toggle("hidden", isMuted);
        mutedIcon.classList.toggle("hidden", !isMuted);

        muteButton.setAttribute(
          "aria-label",
          isMuted ? "Unmute audio" : "Mute audio"
        );
      });

      /* -----------------------------
       * Audio loading error
       * ----------------------------- */

      audio.addEventListener("error", () => {
        console.error(
          "The audio file could not be loaded:",
          audio.currentSrc
        );

        // duration.textContent = "--:--";
      });
    });
  }

  initializePlayers();

  // Also works correctly when Astro page navigation is used.
  document.addEventListener("astro:page-load", initializePlayers);
</script>