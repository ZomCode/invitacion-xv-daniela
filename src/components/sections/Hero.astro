---
import Section from "@/components/Section.astro";
import H2 from '@/assets/h2-title.astro'
import H3 from '@/assets/h3-title.astro'
---
<!-- MAIN -->
	<Section class:list={"min-h-svh items-center justify-end min-w-full bg-[url('/dani3.jpeg')] bg-fixed bg-cover bg-center bg-no-repeat overflow-hidden"}>
		<article class="flex flex-col w-full bg-linear-to-t from-dusty-rose-700 from-0% via-transparent via-35% to-transparent px-4 pb-14 gap-4 h-screen items-center justify-end">
			<header class="flex items-center justify-evenly">
				<div class="h-0.5 bg-dusty-rose-300 w-24"></div>
				<h1 class="font-dancing text-center text-6xl text-dusty-rose-300">
					Mis XV
				</h1>
				<div class="h-0.5 bg-dusty-rose-300 w-24"></div>
			</header>
			<h2 class="text-2xl font-bold text-dusty-rose-300">ALEXA DANIELA TERRAZAS FLORES</h2>
		</article>
	</Section>