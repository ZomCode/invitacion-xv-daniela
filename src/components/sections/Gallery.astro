---
import Section from '@/components/Section.astro'
import PictureComponent from '@/components/Picture.astro'
---
<Section class:list={"min-h-[75svh] md:min-h-svh flex flex-col justify-start items-center relative"}>
    <p class="text-gray-800">Puedes tocar la imagen para verla.</p>
    <PictureComponent 
        alt={"Daniela Terrazas Flores"} 
        src={"/dani1.jpeg"} 
        msg={"Mis XV"}
        class:list={"absolute z-20 hover:rotate-0 active:rotate-0 rotate-12"}
    />
    <PictureComponent 
        alt={"Daniela Terrazas Flores"} 
        src={"/dani2.jpeg"} 
        msg={"Daniela Terrazas Flores"}
        class:list={"absolute z-10 hover:rotate-0 active:rotate-0 -rotate-12"}
    />
</Section>