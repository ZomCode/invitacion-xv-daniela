---
import Section from "@/components/Section.astro";
import Divider from "@/components/Divider.astro";
import TitleParents from "@/assets/title-parents.astro";
import IconButterfly from "@/assets/icon-butterfly.astro";
---
<Section class:list={"min-h-svh items-center justify-center text-dusty-rose-800 bg-dusty-rose-400 gap-10 text-4xl px-8"}>
    <Divider class:list={"z-100 -top-4"}/>
    <div class="bg-dusty-rose-700 w-full h-0.5"></div>
    <article class="flex flex-col items-center justify-center w-full gap-4">
        <header class="w-full">
            <h2 class="first-letter:text-6xl font-dancing first-letter:text-dusty-rose-900 text-dusty-rose-800">MIS PADRES</h2>
        </header>
        <body>
            <div class="flex gap-4">
                <TitleParents text="karen"/>
                <TitleParents text="flores"/>
                <TitleParents text="lopez"/>
            </div>
            <h2>&</h2>
            <div class="flex gap-4">
                <TitleParents text="alejandro"/>
                <TitleParents text="terrazas"/>
                <TitleParents text="flores"/>
            </div>
        </body>
    </article>
    <div class="bg-dusty-rose-700 w-full h-0.5"></div>

    <article class="flex flex-col items-center justify-center w-full gap-4">
        <header class="w-full">
            <h2 class="first-letter:text-6xl font-dancing first-letter:text-dusty-rose-900 text-dusty-rose-800">MIS PADRINOS</h2>
        </header>
        <body>
            <div class="flex gap-4">
                <TitleParents text="liliana"/>
                <TitleParents text="ramirez"/>
                <TitleParents text="ramirez"/>
            </div>
            <h2>&</h2>
            <div class="flex gap-4">
                <TitleParents text="israel"/>
                <TitleParents text="flores"/>
                <TitleParents text="lopez"/>
            </div>
        </body>
    </article>
    <div class="bg-dusty-rose-800 w-full h-0.5"></div>
    <footer>
        <IconButterfly class:list={"text-dusty-rose-700 w-24"}/>
    </footer>
    <Divider />
</Section>