---
import Section from "@/components/Section.astro";
import Divider from "@/components/Divider.astro";
import TitleParents from "@/assets/title-parents.astro";
import IconButterfly from "@/assets/icon-butterfly.astro";
---
<Section class:list={"min-h-svh items-center justify-center text-dusty-rose-800 bg-dusty-rose-100 gap-10 text-4xl px-8"}>
    <Divider class:list={"-top-4"}/>
    <!-- <div class="bg-dusty-rose-700 w-full h-0.5"></div> -->
    <img src="/divider1.png" class={"w-full"} alt="divider"/>
    <article class="flex flex-col items-center justify-center w-full gap-4">
        <header class="w-full">
            <h4 class="pb-2 text-2xl text-dusty-rose-400 uppercase">Con el amor de mis</h4>
            <h2 class="font-dancing text-dusty-rose-800 text-6xl">PADRES</h2>
        </header>
        <body>
            <article class="flex gap-4">
                <TitleParents text="alejandro"/>
                <TitleParents text="terrazas"/>
                <TitleParents text="flores"/>
            </article>
            <h2 class="text-golden">&</h2>
            <article class="flex gap-4">
                <TitleParents text="karen"/>
                <TitleParents text="flores"/>
                <TitleParents text="lopez"/>
            </article>
        </body>
    </article>
    <img src="/divider1.png" class={"w-full"} alt="divider"/>
    <!-- <div class="bg-dusty-rose-700 w-full h-0.5"></div> -->
    <article class="flex flex-col items-center justify-center w-full gap-4">
        <header class="w-full">
            <h4 class="pb-2 text-2xl text-dusty-rose-400 uppercase">y el cariño de mis</h4>
            <h2 class="font-dancing text-dusty-rose-800 text-6xl">PADRINOS</h2>
        </header>
        <body>
            <article class="flex gap-4">
                <TitleParents text="israel"/>
                <TitleParents text="flores"/>
                <TitleParents text="lopez"/>
            </article>
            <h2 class="text-golden">&</h2>
            <article class="flex gap-4">
                <TitleParents text="liliana"/>
                <TitleParents text="ramirez"/>
                <TitleParents text="ramirez"/>
            </article>
        </body>
    </article>
    <img src="/divider1.png" class={"w-full"} alt="divider"/>
    <!-- <div class="bg-dusty-rose-800 w-full h-0.5"></div> -->
    <footer>
        <IconButterfly class:list={"text-dusty-rose-700 w-24"}/>
    </footer>
    <Divider />
</Section>