---
interface Props{
    TIMESTAMP: Number;
}

const { TIMESTAMP } = Astro.props
---
<section data-date={TIMESTAMP} class="flex flex-col justify-center items-center text-center text-dusty-rose-100 font-bold gap-8 p-4 shadow rounded-2xl mx-1 bg-dusty-rose-500/20">
    <h2 class="text-2xl text-pretty">SÁBADO, 26 DE DICIEMBRE DEL 2026</h2>
    <h2 class="font-dancing text-2xl text-dusty-rose-100">Tan solo falta</h2>
    <article class="flex items-center gap-2">
        <div class="flex flex-col items-center rounded-2xl p-2 shadow-lg w-20 h-20">
            <span class="text-4xl" data-days>00</span>
            <span >Dias</span>
        </div>
        <!-- <div class="text-4xl">:</div> -->
        <div class="flex flex-col items-center rounded-2xl p-2 shadow-lg w-20 h-20">
            <span class="text-4xl" data-hours>00</span>
            <span>Horas</span>
        </div>
        <!-- <div class="text-4xl">:</div> -->
        <div class="flex flex-col items-center rounded-2xl p-2 shadow-lg w-20 h-20">
            <span class="text-4xl" data-minutes>00</span>
            <span>Minutos</span>
        </div>
        <!-- <div class="text-4xl">:</div> -->
        <div class="flex flex-col items-center rounded-2xl p-2 shadow-lg w-20 h-20">
            <span class="text-4xl" data-seconds>00</span>
            <span>Segundos</span>
        </div>
    </article>
    <h2 class="font-dancing text-2xl text-dusty-rose-100">para este día tan especial</h2>
</section>