---
import IconChurch from '@/assets/icon-church.astro';
import IconClock from '@/assets/icon-clock.astro';
import IconMapPin from '@/assets/icon-map-pin.astro';
import Paragraph from '@/assets/Paragraph.astro';

import BtnLink from '@/components/BtnLocation.astro';

interface Props {
    img: string;
    alt: string;
    toolTip: string;
    title: string;
    address: string;
    link: string;
    msg: string;
    hour: string;
}

const { img, alt, toolTip, title, address, link, msg, hour } = Astro.props
---

<article class="flex flex-col items-center justify-center rounded-2xl overflow-hidden shadow-2xl mx-2">
        <header class="relative w-full">
            <div class="flex items-center justify-center gap-3 absolute top-2 left-2 bg-dusty-rose-300 rounded-2xl p-2">
                <IconChurch class:list={"text-dusty-rose-700 w-4 stroke-2"}/>
                <p class="text-dusty-rose-700">{ toolTip }</p>
            </div>
            <picture class="*:object-cover *:h-52  *:w-full">
                <source srcset={ img } type="img/webp">
                <img src={ img } alt={ alt }>
            </picture>
        </header>
        <article class="flex flex-col items-center justify-center gap-4 p-4">
            <h3 class="text-dusty-rose-300 text-4xl text-left font-dancing">{ title }</h3>
            <article class="flex items-center justify-center gap-2 p-1">
                <IconMapPin class:list={"w-12 text-dusty-rose-300"} />
                <Paragraph>{ address }</Paragraph>
            </article>
            <article class="flex items-center justify-around text-dusty-rose-200 bg-dusty-rose-600 rounded-2xl p-2 w-full">
                <IconClock class:list={"stroke-3 w-8 text-dusty-rose-200 bg-dusty-rose-400 p-1 rounded-full"}/>
                <div class="flex flex-col items-start justify-center gap-1 font-bold">
                    <div class="text-2xl">{ msg }</div>
                    <!-- <div class="text-xl">15:00 HRS</div> -->
                    <p class="text-2xl font-bold">{ hour }</p>
                </div>
                <!-- <p class="text-2xl font-bold">3:00<br/>PM</p> -->
            </article>
            <slot name="frame-place"/>
            <BtnLink link={ link }/>
        </article>
    </article>