---
import IconLocation from '@/assets/icon-location.astro'

interface Props {
    link?: string;
}

const link = Astro.props.link
---
<a 
    href={ link } 
    target="_blank" 
    referrerpolicy="no-referrer"
    class="flex items-center justify-center gap-2 w-full text-golden font-bold hover:bg-dusty-rose-500 active:bg-dusty-rose-500 bg-dusty-rose-600 border-2 border-dusty-rose-800 px-4 py-2 rounded-full m-4" 
>
    <IconLocation class:list={"w-4 text-golden"}/>
    VER UBICACIÓN EN GOOGLE MAPS
</a>
