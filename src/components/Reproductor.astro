---
import IconMute from '@/assets/icon-mute.astro';
import IconPause from '@/assets/icon-pause.astro';
import IconPlay from '@/assets/icon-play.astro';
import IconVolume from '@/assets/icon-volume.astro';

interface Props {
  src: string;
  title?: string;
}

const {
  src,
  title = "Audio Player",
} = Astro.props;
---

<div
  data-media-player
  class="w-full max-w-2xl rounded-2xl border p-5 shadow-lg
         border-dusty-rose-200 bg-dusty-rose-900/50"
>
  <!-- Actual audio element -->
  <audio
    data-audio
    src={src}
    preload="metadata"
  ></audio>

  <!-- Title -->
  <div class="mb-5">
    <!-- <p class="text-xs font-medium uppercase tracking-widest text-dusty-rose-500">
      Now playing
    </p> -->

    <h2
      class="mt-1 truncate text-lg font-semibold text-dusty-rose-100"
    >
      {title}
    </h2>
  </div>

  <!-- Main controls -->
  <div class="flex items-center gap-4">

    <!-- Play / Pause -->
    <button
      data-play
      type="button"
      aria-label="Play audio"
      class="flex size-12 shrink-0 items-center justify-center rounded-full
             bg-dusty-rose-600 text-white transition
             hover:bg-dusty-rose-700
             focus:outline-none focus:ring-2 focus:ring-dusty-rose-500
             focus:ring-offset-2
             focus:ring-offset-dusty-rose-900"
    >
      <!-- Play icon -->
      <IconPlay class:list={"size-6"}/>
      <!-- Pause icon -->
      <IconPause class:list={"hidden size-6"}/>
    </button>

    <!-- Progress -->
    <div class="min-w-0 flex-1">

      <label class="sr-only" for="audio-progress">
        Audio progress
      </label>

      <input
        data-progress
        id="audio-progress"
        type="range"
        min="0"
        max="0"
        value="0"
        step="0.01"
        class="h-2 w-full cursor-pointer accent-dusty-rose-600"
        aria-label="Audio progress"
      />

      <!-- Time -->
      <div
        class="mt-1 flex justify-between text-xs tabular-nums text-dusty-rose-400"
      >
        <span data-current-time>0:00</span>
        <!-- <span data-duration>0:00</span> -->
      </div>
    </div>
  </div>

  <!-- Volume -->
  <div
    class="mt-5 flex items-center justify-end gap-3 border-t pt-4 border-dusty-rose-100"
  >
    <button
      data-mute
      type="button"
      aria-label="Mute audio"
      class="rounded-lg p-2 transition
             text-dusty-rose-400
             hover:bg-dusty-rose-800 hover:text-white"
    >
      <!-- Volume icon -->
      <IconVolume class:list={"text-dusty-rose-400 size-5"}/>

      <!-- Muted icon -->
      <IconMute class:list={"text-dusty-rose-400 size-5 hidden"}/>

    </button>

    <label class="sr-only" for="audio-volume">
      Volume
    </label>

    <input
      data-volume
      id="audio-volume"
      type="range"
      min="0"
      max="1"
      value="0.8"
      step="0.01"
      class="h-2 w-28 cursor-pointer accent-dusty-rose-600"
      aria-label="Volume"
    />

    <span
      data-volume-value
      class="w-9 text-right text-xs tabular-nums text-dusty-rose-400"
    >
      80%
    </span>
  </div>
</div>

<script>
  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds)) {
      return "0:00";
    }

    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = Math.floor(seconds % 60);

    return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
  }

  function initializePlayers() {
    const players =
      document.querySelectorAll<HTMLElement>("[data-media-player]");

    players.forEach((player) => {
      // Prevent the same player from being initialized twice
      if (player.dataset.initialized === "true") {
        return;
      }

      player.dataset.initialized = "true";

      const audio =
        player.querySelector<HTMLAudioElement>("[data-audio]");

      const playButton =
        player.querySelector<HTMLButtonElement>("[data-play]");

      const playIcon =
        player.querySelector<SVGElement>("[data-play-icon]");

      const pauseIcon =
        player.querySelector<SVGElement>("[data-pause-icon]");

      const progress =
        player.querySelector<HTMLInputElement>("[data-progress]");

      const currentTime =
        player.querySelector<HTMLElement>("[data-current-time]");

      const duration =
        player.querySelector<HTMLElement>("[data-duration]");

      const volume =
        player.querySelector<HTMLInputElement>("[data-volume]");

      const volumeValue =
        player.querySelector<HTMLElement>("[data-volume-value]");

      const muteButton =
        player.querySelector<HTMLButtonElement>("[data-mute]");

      const volumeIcon =
        player.querySelector<SVGElement>("[data-volume-icon]");

      const mutedIcon =
        player.querySelector<SVGElement>("[data-muted-icon]");

      if (
        !audio ||
        !playButton ||
        !playIcon ||
        !pauseIcon ||
        !progress ||
        !currentTime ||
        !volume ||
        !volumeValue ||
        !muteButton ||
        !volumeIcon ||
        !mutedIcon
      ) {
        return;
      }

      /* -----------------------------
       * Initial volume
       * ----------------------------- */

      audio.volume = Number(volume.value);

      /* -----------------------------
       * Play / Pause
       * ----------------------------- */

      playButton.addEventListener("click", async () => {
        if (audio.paused) {
          try {
            await audio.play();
          } catch (error) {
            console.error("Unable to play audio:", error);
          }
        } else {
          audio.pause();
        }
      });

      audio.addEventListener("play", () => {
        playIcon.classList.add("hidden");
        pauseIcon.classList.remove("hidden");

        playButton.setAttribute("aria-label", "Pause audio");
      });

      audio.addEventListener("pause", () => {
        playIcon.classList.remove("hidden");
        pauseIcon.classList.add("hidden");

        playButton.setAttribute("aria-label", "Play audio");
      });

      /* -----------------------------
       * Duration
       * ----------------------------- */

      const updateDuration = () => {
        if (!Number.isFinite(audio.duration)) {
          return;
        }
        
        progress.max = String(audio.duration);
        // duration.textContent = formatTime(audio.duration);
      };

      audio.addEventListener("loadedmetadata", updateDuration);
      audio.addEventListener("durationchange", updateDuration);

      /* -----------------------------
       * Progress
       * ----------------------------- */

      audio.addEventListener("timeupdate", () => {
        progress.value = String(audio.currentTime);
        currentTime.textContent = formatTime(audio.currentTime);
      });

      progress.addEventListener("input", () => {
        if (!Number.isFinite(audio.duration)) {
          return;
        }

        const newTime = Number(progress.value);

        audio.currentTime = newTime;
        currentTime.textContent = formatTime(newTime);
      });

      /* -----------------------------
       * Audio finished
       * ----------------------------- */

      audio.addEventListener("ended", () => {
        playIcon.classList.remove("hidden");
        pauseIcon.classList.add("hidden");

        playButton.setAttribute("aria-label", "Play audio");
      });

      /* -----------------------------
       * Volume
       * ----------------------------- */

      volume.addEventListener("input", () => {
        const value = Number(volume.value);

        audio.volume = value;
        audio.muted = value === 0;

        volumeValue.textContent = `${Math.round(value * 100)}%`;
      });

      /* -----------------------------
       * Mute
       * ----------------------------- */

      muteButton.addEventListener("click", () => {
        audio.muted = !audio.muted;
      });

      audio.addEventListener("volumechange", () => {
        const isMuted = audio.muted || audio.volume === 0;

        volumeIcon.classList.toggle("hidden", isMuted);
        mutedIcon.classList.toggle("hidden", !isMuted);

        muteButton.setAttribute(
          "aria-label",
          isMuted ? "Unmute audio" : "Mute audio"
        );

        if (audio.muted) {
          volumeValue.textContent = "0%";
        } else {
          volume.value = String(audio.volume);
          volumeValue.textContent =
            `${Math.round(audio.volume * 100)}%`;
        }
      });

      /* -----------------------------
       * Audio loading error
       * ----------------------------- */

      audio.addEventListener("error", () => {
        console.error(
          "The audio file could not be loaded:",
          audio.currentSrc
        );

        // duration.textContent = "--:--";
      });
    });
  }

  initializePlayers();

  // Also works correctly when Astro page navigation is used.
  document.addEventListener("astro:page-load", initializePlayers);
</script>