---
import Section from '@/components/Section.astro';
import Divider from '@/components/Divider.astro';
import SectionFixed from '@/components/SectionFixed.astro';
import Reproductor from '@/components/Reproductor.astro';

const TIMESTAMP = 1797051600000;
---

<main class="flex flex-col items-center justify-center">
	<SectionFixed img="bg-1.webp">
		<Section class="min-h-svh min-w-svw flex items-center justify-end">
			<header class="mx-auto px-4 sm:px-6 lg:px-8">
				<h1 
					class="
						pb-12
						font-dancing 
						text-center 
						text-6xl 
						text-dusty-rose-500
						"
					>
						Mis XV
					</h1>
				</header>
		</Section>
	</SectionFixed>
	<Section class:list={"min-h-screen bg-dusty-rose-400 items-center justify-center gap-24 text-4xl font-dancing px-8"}>
		<Divider class:list={"z-100 -top-4"}/>
		<header class="w-full border-b border-b-dusty-rose-600/50">
			<h2>MIS PADRES</h2>
		</header>
		<article class="flex flex-col items-center justify-center gap-8">
			<h2>KAREN FLORES LOPEZ</h2>
			<h2>&</h2>
			<h2>ALEJANDRO TERRAZAS FLORES</h2>
		</article>
		<Divider />
	</Section>
	<Section class:list={"min-h-[75svh] justify-center items-center bg-dusty-rose-900 px-8"}>
		<!-- REPRODUCTOR DE MÚSICA -->
		<h2 class="text-dusty-rose-400 font-dancing text-4xl pb-8">UN POCO DE MÚSICA</h2>
		<Reproductor 
			src="/Calvin Harris - Blame (Audio) ft. John Newman.mp3"
			title="Calvin Harris - Blame ft. John Newman"
		/>
		<Divider />
	</Section>
	<Section class:list={"min-h-screen justify-between items-center bg-dusty-rose-400 p-8"}>
		<!-- CARTA -->
		<article class="w-full flex justify-center items-center">
			<div class="relative h-160 sm:h-160 max-h-screen w-full max-w-175">
				<div
					class="
						absolute left-1/2 top-2 md:top-8 z-20
						h-120 md:h-90  w-[82%]
						-translate-x-1/2
						rounded-sm
						bg-[#fffdf7]
						p-4 md:p-10
						shadow-xl
						transition-transform duration-500
					"
				>
					<!-- Texto -->
					<h2
						class="
						mb-6
						font-serif
						text-3xl
						italic
						text-stone-800
						"
					>
						Para mis queridos invitados,
					</h2>
					<p
						class="
						font-serif
						text-lg
						leading-8
						text-stone-600
						"
					>
						Hay palabras que merecen ser escritas con calma,
						guardadas entre papel y tinta, y entregadas como
						pequeños recuerdos.
					</p>
					<p
						class="
						mt-5
						font-serif
						text-lg
						leading-8
						text-stone-600
						"
					>
						Espero que esta carta encuentre un lugar especial
						entre tus recuerdos y que cada palabra conserve
						un poco del momento en que fue escrita.
					</p>
				</div>
				<div
					class="
						absolute
						bottom-50
						sm:bottom-64
						left-1/2
						z-10
						h-34
						sm:h-70
						w-[90%]
						-translate-x-1/2
						origin-bottom
						bg-[#ded2bd]
						shadow-md
						[clip-path:polygon(0_100%,50%_0,100%_100%)]
						sm:[clip-path:polygon(0_100%,50%_0,100%_100%)]
					"
				>
					<!-- Interior de la solapa -->
					<div
						class="
						absolute inset-1.5
						bg-[#795731]
						[clip-path:polygon(0_100%,50%_0,100%_100%)]
						sm:[clip-path:polygon(0_100%,50%_0,100%_100%)]
						"
					>
					</div>
				</div>
				<div
					class="
						absolute
						bottom-0
						left-1/2
						z-30
						h-52
						sm:h-66
						w-[90%]
						-translate-x-1/2
						overflow-hidden
						rounded-b-md
						bg-[#d6c6aa]
						shadow-2xl
					"
				>
					<!-- Pliegue izquierdo -->
					<div
						class="
						absolute inset-0
						bg-[#e3d7c2]
						[clip-path:polygon(0_0,55%_50%,0_100%)]
						"
					>
					</div>
					<!-- Pliegue derecho -->
					<div
						class="
						absolute inset-0
						bg-[#d8cab1]
						[clip-path:polygon(100%_0,45%_50%,100%_100%)]
						"
					>
					</div>
					<!-- Pliegue inferior -->
					<div
						class="
						absolute inset-0
						bg-[#eadfca]
						[clip-path:polygon(0_100%,50%_42%,100%_100%)]
						"
					>
					</div>
					<!-- BROCHE -->
					<div
						class="
						absolute
						bottom-22
						sm:bottom-28
						left-1/2
						z-40
						-translate-x-1/2
						"
					>
						<!-- Broche exterior -->
						<div
							class="
								relative
								flex h-14 w-14
								items-center justify-center
								rounded-full
								border-[3px]
								border-[#92734c]
								bg-linear-to-br
								from-[#d9bd83]
								via-[#b58c55]
								to-[#795731]
								shadow-lg
							"
						>
							<!-- Círculo interior -->
							<div
								class="
								flex h-10 w-10
								items-center justify-center
								rounded-full
								border
								border-[#ead6a8]/60
								bg-[#a77b46]
								shadow-inner
								"
							>
								<!-- Inicial -->
								<span
								class="
									font-dancing
									text-xl
									font-bold
									italic
									text-[#f2dfb8]
								"
								>
								D
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</article>
		<!-- TIMER  -->
		<article
			data-date={TIMESTAMP}
			class="flex flex-col justify-center items-center text-center text-dusty-rose-100 font-bold"
		>
			<h2 class="text-xl">SÁBADO, 31 DE DICIEMBRE DEL 2026</h2>
			<div class="flex gap-4">
				<div class="flex flex-col items-center">
					<span class="text-4xl" data-days>00</span>
					<span>Dias</span>
				</div>
				<div class="flex flex-col items-center">
					<span class="text-4xl" data-hours>00</span>
					<span>Horas</span>
				</div>
				<div class="flex flex-col items-center">
					<span class="text-4xl" data-minutes>00</span>
					<span>Minutos</span>
				</div>
				<div class="flex flex-col items-center">
					<span class="text-4xl" data-seconds>00</span>
					<span>Segundos</span>
				</div>
			</div>
		</article>
		<!-- GALERIA DE FOTOS  -->
		<article></article>
	</Section>
	<Section class:list={"bg-dusty-rose-800"}>
		<!-- MAPA  -->
		<section class="flex flex-col items-center justify-between relative">
			<h2 class="text-dusty-rose-600 text-3xl font-dancing pt-4">UBICACIÓN</h2>
			<article class="flex flex-col items-center py-4">
				<h3 class="text-dusty-rose-500 text-xl">SALÓN DE EVENTOS "EL CASTILLO"</h3>
				<p class="pb-4 text-dusty-rose-300">Av. de la Juventud 123, Col. Centro, Ciudad, Estado, CP 12345</p>
				<iframe 
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d655.8250494733261!2d-98.20129788532378!3d19.047031649102145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cfc0dddc0419a3%3A0xb7f90728d223a4bb!2sIglesia%20Metodista%20de%20M%C3%A9xico%2C%20Templo%20Emmanuel!5e0!3m2!1ses-419!2smx!4v1786343960597!5m2!1ses-419!2smx"
					width="350"
					height="350"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
				>
				</iframe>
			</article>
			<article class="flex flex-col items-center py-4">
				<h3 class="text-dusty-rose-500 text-xl">IGLESIA "SAN JUAN BAUTISTA"</h3>
				<p class="pb-4 text-dusty-rose-300">Calle Principal 456, Col. Centro, Ciudad, Estado, CP 67890</p>
				<iframe 
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d655.8250494733261!2d-98.20129788532378!3d19.047031649102145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cfc0dddc0419a3%3A0xb7f90728d223a4bb!2sIglesia%20Metodista%20de%20M%C3%A9xico%2C%20Templo%20Emmanuel!5e0!3m2!1ses-419!2smx!4v1786343960597!5m2!1ses-419!2smx"
					width="350"
					height="350"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
				>
				</iframe>
			</article>
			<Divider class:list={"opacity-75"}/>
		</section>
		<!-- CÓDIGO DE VESTIMENTA  -->
		<section class="flex flex-col items-center justify-center relative">
			<article class="text-center p-12 relative">
				<h2 class="text-3xl text-dusty-rose-50 font-dancing">CÓDIGO DE VESTIMENTA</h2>
				<h3 class="text-2xl py-4 text-dusty-rose-100">Formal</h3>
			</article>
			<Divider class:list={"opacity-75"}/>
		 </section>
		<!-- GIFTS  -->
		<!-- <article></article> -->
	</Section>
	<Section>
		<!-- CONFIRMAR ASISTENCIA -->
		<article></article>
	</Section>
</main>

<script>
	const SECOND = 1000;
	const MINUTE = 60 * SECOND;
	const HOUR = 60 * MINUTE;
	const DAY = 24 * HOUR;

	function init() {
		const $countdown = document.querySelector("[data-date]");
		if (!$countdown) return;

		const $meses = $countdown.querySelector("[data-meses]");
		const $days = $countdown.querySelector("[data-days]");
		const $hours = $countdown.querySelector("[data-hours]");
		const $minutes = $countdown.querySelector("[data-minutes]");
		const $seconds = $countdown.querySelector("[data-seconds]");

		const timestamp = $countdown.getAttribute("data-date");
		if (!timestamp) return;

		const date = new Date(+timestamp).getTime();

		const formatTime = (time: number) => {
			return Math.floor(time).toString().padStart(2, "0");
		};
		function updateCountdown() {
			const now = Date.now();
			const diff = date - now;

			if ($days instanceof HTMLElement) {
				$days.innerText = formatTime(diff / DAY);
			}
			if ($hours instanceof HTMLElement) {
				$hours.innerText = formatTime((diff % DAY) / HOUR);
			}
			if ($minutes instanceof HTMLElement) {
				$minutes.innerText = formatTime((diff % HOUR) / MINUTE);
			}
			if ($seconds instanceof HTMLElement) {
				$seconds.innerText = formatTime((diff % MINUTE) / SECOND);
			}
		}

		setInterval(updateCountdown, SECOND);
  	}

  init();
</script>