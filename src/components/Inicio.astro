---
import Hero from '@/components/sections/Hero.astro';

import Section from '@/components/Section.astro';
import Divider from '@/components/Divider.astro';
import Parents from '@/components/sections/Parents.astro';
import MusicPlayer from '@/components/sections/MusicPlayer.astro';
import Letter from '@/components/sections/Letter.astro'
import Timer from '@/components/sections/Timer.astro'
import Gallery from '@/components/sections/Gallery.astro'
import ReproductorV2 from '@/components/ReproductorV2.astro';
import ConfirmAssistance from '@/components/sections/ConfirmAssistance.astro'
import LocationAndDressCode from '@/components/sections/LocationAndDressCode.astro'

const TIMESTAMP = 1798300800000;
---

<main class="flex flex-col items-center justify-center relative">
	
	<Hero />
	<Parents />
	<!-- <MusicPlayer /> -->
	<!-- CARTA | TIMER | GALERIA -->
	<Section class:list={"min-h-svh items-center justify-between bg-dusty-rose-400 px-4 py-8 gap-12"}>
		<Letter />
		<Timer TIMESTAMP={ TIMESTAMP } />
		<Gallery />
		<Divider />
	</Section>
	<LocationAndDressCode />
	<ConfirmAssistance />
	<ReproductorV2 
		src="/Lana Del Rey - Once Upon A Dream.mp3"
		title="Lana Del Rey - Once Upon A Dream"
	/>
</main>

<script>
	const SECOND = 1000;
	const MINUTE = 60 * SECOND;
	const HOUR = 60 * MINUTE;
	const DAY = 24 * HOUR;

	function init() {
		const $countdown = document.querySelector("[data-date]");
		if (!$countdown) return;

		const $meses = $countdown.querySelector("[data-meses]");
		const $days = $countdown.querySelector("[data-days]");
		const $hours = $countdown.querySelector("[data-hours]");
		const $minutes = $countdown.querySelector("[data-minutes]");
		const $seconds = $countdown.querySelector("[data-seconds]");

		const timestamp = $countdown.getAttribute("data-date");
		if (!timestamp) return;

		const date = new Date(+timestamp).getTime();

		const formatTime = (time: number) => {
			return Math.floor(time).toString().padStart(2, "0");
		};
		function updateCountdown() {
			const now = Date.now();
			const diff = date - now;

			if ($days instanceof HTMLElement) {
				$days.innerText = formatTime(diff / DAY);
			}
			if ($hours instanceof HTMLElement) {
				$hours.innerText = formatTime((diff % DAY) / HOUR);
			}
			if ($minutes instanceof HTMLElement) {
				$minutes.innerText = formatTime((diff % HOUR) / MINUTE);
			}
			if ($seconds instanceof HTMLElement) {
				$seconds.innerText = formatTime((diff % MINUTE) / SECOND);
			}
		}

		setInterval(updateCountdown, SECOND);
  	}

  init();
</script>