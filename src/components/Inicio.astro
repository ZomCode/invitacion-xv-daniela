---
import Section from '@/components/Section.astro';
import Divider from '@/components/Divider.astro';
import BtnLink from '@/components/BtnUbicación.astro'
import Reproductor from '@/components/Reproductor.astro';
import PictureComponent from '@/components/Picture.astro';
import H2 from '@/assets/h2-title.astro';
import H3 from '@/assets/h3-title.astro';
import Paragraph from '@/assets/Paragraph.astro'
import IconChurch from '@/assets/icon-church.astro';
import IconCastle from '@/assets/icon-castle.astro';
import IconWhatsapp from '@/assets/icon-whatsapp.astro';

const TIMESTAMP = 1797051600000;
---

<main class="flex flex-col items-center justify-center">
	<Section class:list={"min-h-svh items-center justify-end min-w-full bg-[url('/bg-1.webp')] bg-fixed bg-cover bg-center bg-no-repeat overflow-hidden"}>
		<header class="mx-auto px-4 sm:px-6 lg:px-8">
			<h1 
				class="
					pb-12
					font-dancing 
					text-center 
					text-6xl 
					text-dusty-rose-500
				"
			>
				Mis XV
			</h1>
		</header>
	</Section>
	<Section class:list={"min-h-svh items-center justify-center bg-dusty-rose-400 gap-18 text-4xl font-dancing px-8"}>
		<Divider class:list={"z-100 -top-4"}/>
		<header class="w-full">
			<h2>MIS PADRES</h2>
		</header>
		<div class="bg-dusty-rose-700 w-full h-0.5"></div>
		<article class="flex flex-col items-center justify-center w-full gap-10">
			<h2>KAREN FLORES LOPEZ</h2>
			<h2>&</h2>
			<h2>ALEJANDRO TERRAZAS FLORES</h2>
		</article>
		<footer>
			<!-- agregar una imagen de una mariposa -->
		</footer>
		<Divider />
	</Section>
	<Section class:list={"min-h-[75svh] items-center justify-center bg-dusty-rose-900 px-8"}>
		<!-- REPRODUCTOR DE MÚSICA -->
		<h2 class="text-dusty-rose-400 font-dancing text-4xl pb-8">UN POCO DE MÚSICA</h2>
		<Reproductor 
			src="/Calvin Harris - Blame (Audio) ft. John Newman.mp3"
			title="Calvin Harris - Blame ft. John Newman"
		/>
		<Divider />
	</Section>
	<Section class:list={"min-h-svh items-center justify-between bg-dusty-rose-400 px-4 py-8 gap-12"}>
		<!-- CARTA -->
		<article class="w-full flex justify-center items-center">
			<div class="relative h-160 sm:h-160 max-h-screen w-full max-w-175">
				<div
					class="
						absolute left-1/2 top-2 md:top-8 z-20
						h-120 md:h-90  w-[75%]
						-translate-x-1/2
						rounded-sm
						bg-gray-100
						p-4 md:p-10
						shadow-xl
						transition-transform duration-500
					"
				>
					<!-- Texto -->
					<H2>
						Para mis queridos invitados,
					</H2>
					<p
						class="
						font-serif
						text-lg
						leading-8
						text-stone-600
						"
					>
						Me haría mucha ilusión que me acompañaras a celebrar mis XV años.
						Es un momento especial para mi y me encantaría compartirlo con las personas que mas quiero.
						Tu presencia haría que este día sea aún mas inolvidable.
					</p>
				</div>
				<div
					class="
						absolute
						bottom-50
						sm:bottom-64
						left-1/2
						z-10
						h-34
						sm:h-70
						w-[90%]
						-translate-x-1/2
						origin-bottom
						bg-[#ded2bd]
						shadow-md
						[clip-path:polygon(0_100%,50%_0,100%_100%)]
						sm:[clip-path:polygon(0_100%,50%_0,100%_100%)]
					"
				>
					<!-- Interior de la solapa -->
					<div
						class="
						absolute inset-1.5
						bg-[#795731]
						[clip-path:polygon(0_100%,50%_0,100%_100%)]
						sm:[clip-path:polygon(0_100%,50%_0,100%_100%)]
						"
					>
					</div>
				</div>
				<div
					class="
						absolute
						bottom-0
						left-1/2
						z-30
						h-52
						sm:h-66
						w-[90%]
						-translate-x-1/2
						overflow-hidden
						rounded-b-md
						bg-[#d6c6aa]
						shadow-2xl
					"
				>
					<!-- Pliegue izquierdo -->
					<div
						class="
						absolute inset-0
						bg-[#e3d7c2]
						[clip-path:polygon(0_0,55%_50%,0_100%)]
						"
					>
					</div>
					<!-- Pliegue derecho -->
					<div
						class="
						absolute inset-0
						bg-[#d8cab1]
						[clip-path:polygon(100%_0,45%_50%,100%_100%)]
						"
					>
					</div>
					<!-- Pliegue inferior -->
					<div
						class="
						absolute inset-0
						bg-[#eadfca]
						[clip-path:polygon(0_100%,50%_42%,100%_100%)]
						"
					>
					</div>
					<!-- BROCHE -->
					<div
						class="
						absolute
						bottom-22
						sm:bottom-28
						left-1/2
						z-40
						-translate-x-1/2
						"
					>
						<!-- Broche exterior -->
						<div
							class="
								relative
								flex h-14 w-14
								items-center justify-center
								rounded-full
								border-[3px]
								border-[#92734c]
								bg-linear-to-br
								from-[#d9bd83]
								via-[#b58c55]
								to-[#795731]
								shadow-lg
							"
						>
							<!-- Círculo interior -->
							<div
								class="
								flex h-10 w-10
								items-center justify-center
								rounded-full
								border
								border-[#ead6a8]/60
								bg-[#a77b46]
								shadow-inner
								"
							>
								<!-- Inicial -->
								<span
								class="
									font-dancing
									text-xl
									font-bold
									italic
									text-[#f2dfb8]
								"
								>
								D
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</article>
		<!-- TIMER  -->
		<section
			data-date={TIMESTAMP}
			class="flex flex-col justify-center items-center text-center text-dusty-rose-100 font-bold gap-8 px-4"
		>
			<h2 class="text-3xl">SÁBADO, 31 DE DICIEMBRE DEL 2026</h2>
			<h2 class="font-dancing text-3xl text-dusty-rose-700">Tan solo falta</h2>
			<article class="flex flex-col items-center justify-center uppercase gap-4">
				<div class="flex flex-col items-center">
					<span class="text-8xl" data-days>00</span>
					<span class="text-2xl">Dias</span>
				</div>
				<article class="flex gap-4">
					<div class="flex flex-col items-center">
						<span class="text-4xl" data-hours>00</span>
						<span>Horas</span>
					</div>
					<div class="text-4xl">:</div>
					<div class="flex flex-col items-center">
						<span class="text-4xl" data-minutes>00</span>
						<span>Minutos</span>
					</div>
					<div class="text-4xl">:</div>
					<div class="flex flex-col items-center">
						<span class="text-4xl" data-seconds>00</span>
						<span>Segundos</span>
					</div>
				</article>
			</article>
			<h2 class="font-dancing text-3xl text-dusty-rose-700">para este día tan especial</h2>
		</section>
		<!-- GALERIA DE FOTOS  -->
		<Section class:list={"min-h-[80svh] flex flex-col justify-center items-center relative"}>
			<PictureComponent alt={"Daniela"} src={"/logo-xv-daniela.webp"} class:list={"absolute -translate-y-1/2 -translate-6 z-10 rotate-12"}/>
			<PictureComponent alt={"Daniela"} src={"/logo-xv-daniela.webp"} class:list={"absolute translate-y-1/2 translate-x-2 z-20 -rotate-12"}/>
		</Section>
		<Divider />
	</Section>
	<Section class:list={"bg-dusty-rose-800 px-4"}>
		<!-- MAPA  -->
		<header class="py-12">
			<H2>¿ DÓNDE ?</H2>
			<Paragraph>
				A continuación encontraras el horario y ubicación de los eventos de mi fiesta,
				así como un botón directo a Google Maps para facilitar tu llegada a los lugares.
			</Paragraph>
		</header>
		<img src="/divider1.png" alt="divider" class="px-12" />
		<article class="flex flex-col items-center py-4">
			<H3>SALÓN DE EVENTOS <br> "EL CASTILLO"</H3>
			<Paragraph>Av. de la Juventud 123, Col. Centro, Ciudad, Estado, CP 12345</Paragraph>
			<IconCastle class:list={"text-dusty-rose-400 stroke-1 w-24"}/>
			<!-- <iframe 
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d655.8250494733261!2d-98.20129788532378!3d19.047031649102145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cfc0dddc0419a3%3A0xb7f90728d223a4bb!2sIglesia%20Metodista%20de%20M%C3%A9xico%2C%20Templo%20Emmanuel!5e0!3m2!1ses-419!2smx!4v1786343960597!5m2!1ses-419!2smx"
				width="350"
				height="350"
				style="border:0;"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
			>
			</iframe> -->
			<BtnLink link='#'/>
		</article>
		<article class="flex flex-col items-center py-4">
			<H3>IGLESIA METODISTA <br> "TEMPLO EMMANUEL"</H3>
			<Paragraph>Calle Principal 456, Col. Centro, Ciudad, Estado, CP 67890</Paragraph>
			<IconChurch class:list={"text-dusty-rose-400 stroke-1 w-24"}/>
			<!-- <iframe 
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d655.8250494733261!2d-98.20129788532378!3d19.047031649102145!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cfc0dddc0419a3%3A0xb7f90728d223a4bb!2sIglesia%20Metodista%20de%20M%C3%A9xico%2C%20Templo%20Emmanuel!5e0!3m2!1ses-419!2smx!4v1786343960597!5m2!1ses-419!2smx"
				width="350"
				height="350"
				style="border:0;"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
			>
			</iframe> -->
			<BtnLink link={"https://maps.app.goo.gl/VToTSkay7ty2tH2E6"}/>
		</article>
		<img src="/divider1.png" alt="divider" class="px-12" />
		<!-- CÓDIGO DE VESTIMENTA  -->
		<article class="text-center p-12 relative">
			<H3>CÓDIGO DE VESTIMENTA</H3>
			<Paragraph>Formal</Paragraph>
		</article>
		<img src="/divider1.png" alt="divider" class="px-12" />
		<!-- GIFTS  -->
		<article class="px-8 py-12">
			<H3>REGALOS</H3>
			<Paragraph>Tu presencia es mi mejor regalo, perosi deseas contribuir con un detalle especial, una lluvia de sobres será muy bien recibido con cariño y gratitud.</Paragraph>
		</article>
	</Section>
	<Section class:list={"min-h-svh items-center justify-around w-full bg-[url('/bg-1.webp')] bg-cover bg-center bg-no-repeat"}>
		<article class="flex flex-col items-center justify-center w-full px-8">
			<a href="#" referrerpolicy="no-referrer" class="flex items-center justify-center gap-4 text-dusty-rose-800 bg-dusty-rose-800/15 border border-dusty-rose-900 rounded-full px-8 py-4">
				<IconWhatsapp class:list={"text-dusty-rose-800 w-12"}/>
				<p class="text-2xl">CONFIRMAR</p>
			</a>
		</article>
		<header class="flex flex-col items-center justify-center w-full px-2 py-8 gap-4">
			<H3>CONFIRMA TU ASISTENCIA</H3>
			<p>Quiero compartir este momento tan espacial contigo.</p>
			<p>Por favor ayudanos a confirmar tu asistencia.</p>
		</header>
	</Section>
</main>

<script>
	const SECOND = 1000;
	const MINUTE = 60 * SECOND;
	const HOUR = 60 * MINUTE;
	const DAY = 24 * HOUR;

	function init() {
		const $countdown = document.querySelector("[data-date]");
		if (!$countdown) return;

		const $meses = $countdown.querySelector("[data-meses]");
		const $days = $countdown.querySelector("[data-days]");
		const $hours = $countdown.querySelector("[data-hours]");
		const $minutes = $countdown.querySelector("[data-minutes]");
		const $seconds = $countdown.querySelector("[data-seconds]");

		const timestamp = $countdown.getAttribute("data-date");
		if (!timestamp) return;

		const date = new Date(+timestamp).getTime();

		const formatTime = (time: number) => {
			return Math.floor(time).toString().padStart(2, "0");
		};
		function updateCountdown() {
			const now = Date.now();
			const diff = date - now;

			if ($days instanceof HTMLElement) {
				$days.innerText = formatTime(diff / DAY);
			}
			if ($hours instanceof HTMLElement) {
				$hours.innerText = formatTime((diff % DAY) / HOUR);
			}
			if ($minutes instanceof HTMLElement) {
				$minutes.innerText = formatTime((diff % HOUR) / MINUTE);
			}
			if ($seconds instanceof HTMLElement) {
				$seconds.innerText = formatTime((diff % MINUTE) / SECOND);
			}
		}

		setInterval(updateCountdown, SECOND);
  	}

  init();
</script>