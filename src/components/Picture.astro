---
interface Props {
    src: string;
    alt: string;
    class?: string;
}
---

<article class:list={[
    "flex flex-col items-center justify-center",
    "bg-gray-100 shadow-2xl",
    "p-2 md:p-6 pb-16 md:pb-20",
    "w-46 sm:w-56 md:w-66 lg:w-76", 
    Astro.props.class]}>
    <picture class="border border-dusty-rose-500 aspect-square w-full object-cover mt-2">
        <source src={Astro.props.src} type="image/webp">
        <img src={Astro.props.src} alt={Astro.props.alt}>
    </picture>
</article>