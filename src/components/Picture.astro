---
interface Props {
    src: string;
    alt: string;
    class?: string;
}
---

<article class:list={["w-64 h-84 rounded bg-gray-100 flex flex-col items-center justify-start", Astro.props.class]}>
    <picture class="w-60 h-60 border border-dusty-rose-500 mt-2">
        <source src={Astro.props.src} type="image/webp">
        <img src={Astro.props.src} alt={Astro.props.alt}>
    </picture>
</article>